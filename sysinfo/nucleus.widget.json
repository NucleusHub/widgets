{
  "id": "sysinfo",
  "name": "System Info",
  "description": "Provides live system metrics to the nucleus system widgets",
  "version": "0.1.0",
  "manifestVersion": 1,
  "compatibility": {
    "nucleus": ">=0.1.0 <1.0.0"
  },
  "slot": "system",
  "enabled": true,
  "nginx": {
    "routes": [
      { "path": "/api/sysinfo", "upstream": "sysinfo-server:3010" }
    ]
  },
  "server": {
    "service": "sysinfo-server",
    "port": 3010,
    "depends": [],
    "healthEndpoint": "/api/sysinfo/health"
  }
}
